<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Punt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/bg_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark_color</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="alertDialogTheme">@style/Theme.Punt.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.Punt.Dialog</item>
    </style>

    <style name="Theme.Punt.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:colorBackground">@color/bg_surface</item>
        <item name="colorPrimary">@color/bg_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:listDivider">@drawable/dialog_divider</item>
        <item name="android:divider">@drawable/dialog_divider</item>
        <item name="android:dividerHeight">1dp</item>
    </style>
</resources>
