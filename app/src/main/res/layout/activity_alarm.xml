<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/txt_alarm_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALARM RINGING"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/accent_danger"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/txt_guide_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Swipe left to punt / snooze"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <!-- Ringing Reminder Card Frame -->
    <LinearLayout
        android:id="@+id/card_alarm_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/txt_alarm_reminder_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txt_alarm_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txt_guide_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Swipe right to mark done →"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="12dp" />

</LinearLayout>
