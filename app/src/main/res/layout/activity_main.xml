<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Reminders Main Content View -->
    <LinearLayout
        android:id="@+id/reminders_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Section Summary & Control Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bulk Action Button (Reminders List) -->
            <ImageView
                android:id="@+id/btn_list_export"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_bulk"
                android:contentDescription="Bulk actions"
                android:padding="3dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- Fixed Top Search/Add Input Card -->
        <LinearLayout
            android:id="@+id/card_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp">

            <!-- Filter Icon Button -->
            <ImageView
                android:id="@+id/btn_tags_filter"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_action_filter"
                app:tint="@color/accent"
                android:contentDescription="Filter reminders"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <EditText
                android:id="@+id/search_reminder_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Add or search reminders..."
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"
                android:textSize="15sp"
                android:inputType="textMultiLine|textCapSentences"
                android:scrollHorizontally="false"
                android:maxLines="4"
                android:imeOptions="actionDone"
                android:paddingVertical="4dp"
                android:paddingHorizontal="4dp"
                android:background="@null" />

            <ImageView
                android:id="@+id/btn_add_reminder"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_action_add"
                app:tint="@color/accent"
                android:contentDescription="@string/add_reminder"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/reminders_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="true"
                    tools:listitem="@layout/item_reminder" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/layout_empty_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="120dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_empty_reminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/no_reminders"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_empty_clear_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Clear filter &amp; show all"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- About Main Content View -->
    <LinearLayout
        android:id="@+id/about_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- App Metadata & Actions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_import_markdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/import_markdown"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:letterSpacing="0.05"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:id="@+id/btn_export_markdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/export_markdown"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:letterSpacing="0.05"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:id="@+id/btn_feedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/feedback"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:letterSpacing="0.05"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                    </LinearLayout>
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_donate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/donate"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:letterSpacing="0.05"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:id="@+id/btn_toggle_calendar_sync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calendar_sync_disabled"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:letterSpacing="0.05"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

        <!-- Logs Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPLICATION LOGS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_clear_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_logs"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_danger"
                android:letterSpacing="0.05"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="12dp">

            <TextView
                android:id="@+id/txt_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp" />

        </ScrollView>

    </LinearLayout>

    <!-- Minimal Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/header_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <!-- Subtle Tab Navigation -->
        <TextView
            android:id="@+id/btn_nav_reminders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_reminders"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingVertical="4dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_nav_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_about"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/text_secondary"
            android:paddingVertical="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
